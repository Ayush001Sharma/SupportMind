# ============================================================
# SupportMind Backend — Environment Variables
# ============================================================
# Copy this file to .env and fill in your values.
# NEVER commit .env to version control.
# ============================================================

# ---- Application ----------------------------------------- #
APP_NAME="SupportMind API"
APP_VERSION="0.1.0"
DEBUG=false

# ---- Ollama ---------------------------------------------- #
OLLAMA_BASE_URL="http://localhost:11434"
OLLAMA_CHAT_MODEL="llama3.2:3b"
OLLAMA_EMBEDDING_MODEL="nomic-embed-text"

# ---- ChromaDB -------------------------------------------- #
# Path where ChromaDB persists its data. Relative paths are
# resolved from the directory where uvicorn is started.
CHROMA_PERSIST_DIR=./chromadb_data
CHROMA_COLLECTION_NAME=kb_documents

# ---- RAG / Retrieval ------------------------------------- #
CHUNK_SIZE=800
CHUNK_OVERLAP=150
RETRIEVAL_TOP_K=5
SIMILARITY_THRESHOLD=0.35
CONVERSATION_HISTORY_TURNS=6

# ---- File Upload ----------------------------------------- #
MAX_UPLOAD_SIZE_MB=10
UPLOAD_DIR=./storage/uploaded_files

# ---- CORS ------------------------------------------------ #
# Comma-separated list of allowed origins.
# For local development, include the Vite dev server.
# For production, set this to your Vercel deployment URL.
ALLOWED_ORIGINS=["http://localhost:5173","http://localhost:3000"]

# ---- Logging --------------------------------------------- #
# DEBUG | INFO | WARNING | ERROR | CRITICAL
LOG_LEVEL=INFO
